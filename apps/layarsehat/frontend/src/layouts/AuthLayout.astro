---
import Layout from './Layout.astro';

interface Props {
  title: string;
  judul: string;
  keterangan: string;
}
const { title, judul, keterangan } = Astro.props;
---

<Layout title={title}>
  <div class="latar">
    <div class="bentuk"></div>

    <header class="auth-kepala">
      <a class="merek" href="/">
        <span class="merek-ikon">📱</span>
        <span>LayarSehat</span>
      </a>
      <h1>{judul}</h1>
      <p>{keterangan}</p>
    </header>

    <main class="auth-isi">
      <slot />
    </main>

    <footer class="auth-kaki">
      <a href="/">Beranda</a>
      <span>·</span>
      <a href="/unduh">Unduh aplikasi</a>
    </footer>
  </div>

  <style>
    .latar {
      position: relative;
      min-height: 100vh;
      background: var(--gradien-gelap);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 3.5rem 1.25rem 2rem;
      overflow: hidden;
    }
    /* Lengkungan lembut di belakang kartu, seperti dasbor Argon. */
    .bentuk {
      position: absolute;
      top: -35%;
      left: 50%;
      transform: translateX(-50%);
      width: 160%;
      height: 70%;
      background: radial-gradient(circle at 50% 100%, rgba(94, 114, 228, .45), transparent 62%);
      pointer-events: none;
    }

    .auth-kepala {
      position: relative;
      text-align: center;
      max-width: 460px;
      margin-bottom: 2rem;
    }
    .merek {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      color: #fff;
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
    }
    .merek:hover { color: #fff; opacity: .9; }
    .merek-ikon { font-size: 1.4rem; }
    .auth-kepala h1 { color: #fff; font-size: 1.5rem; margin-bottom: .35rem; }
    .auth-kepala p { color: rgba(255, 255, 255, .75); margin: 0; font-size: .875rem; }

    .auth-isi { position: relative; width: 100%; max-width: 440px; }

    .auth-kaki {
      position: relative;
      margin-top: auto;
      padding-top: 2rem;
      display: flex;
      gap: .6rem;
      color: rgba(255, 255, 255, .55);
      font-size: .8125rem;
    }
    .auth-kaki a { color: rgba(255, 255, 255, .8); }
    .auth-kaki a:hover { color: #fff; }
  </style>
</Layout>
