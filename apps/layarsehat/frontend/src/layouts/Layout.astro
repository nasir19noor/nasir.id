---
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'LayarSehat — pantau dan kendalikan aktivitas smartphone anak Anda.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · LayarSehat</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📱</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <style is:global>
      /* ─────────────────────────────────────────────────────────────
         Sistem desain — mengikuti gaya dasbor Argon
         ───────────────────────────────────────────────────────────── */
      :root {
        --primary: #5e72e4;
        --primary-dark: #324cdd;
        --info: #11cdef;
        --success: #2dce89;
        --danger: #f5365c;
        --warning: #fb6340;
        --dark: #172b4d;
        --dark-2: #1a1f37;

        --putih: #ffffff;
        --abu-100: #f8f9fe;
        --abu-200: #f6f9fc;
        --abu-300: #e9ecef;
        --abu-400: #ced4da;
        --abu-600: #8898aa;
        --abu-700: #525f7f;
        --abu-800: #32325d;

        --radius: .5rem;
        --bayangan: 0 0 2rem 0 rgba(136, 152, 170, .15);
        --bayangan-kuat: 0 .5rem 1.5rem rgba(50, 50, 93, .12), 0 .25rem .5rem rgba(0, 0, 0, .06);
        --gradien: linear-gradient(87deg, #11cdef 0, #1171ef 100%);
        --gradien-gelap: linear-gradient(87deg, #172b4d 0, #1a174d 100%);
        --sidebar-lebar: 250px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--abu-200);
        color: var(--abu-700);
        font-family: 'Open Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        font-size: .875rem;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3, h4, h5 {
        margin: 0 0 .5rem;
        color: var(--abu-800);
        font-weight: 600;
        line-height: 1.3;
      }
      h1 { font-size: 1.75rem; }
      h2 { font-size: 1.35rem; }
      h3 { font-size: 1.0625rem; }
      p { margin: 0 0 1rem; }
      a { color: var(--primary); text-decoration: none; }
      a:hover { color: var(--primary-dark); }

      .wadah { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; width: 100%; }

      /* ── Tipografi pembantu ── */
      .lembut { color: var(--abu-600); }
      .kecil { font-size: .8125rem; }
      .label-kartu {
        display: block;
        font-size: .6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--abu-600);
        margin-bottom: .25rem;
      }
      .angka-besar {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--abu-800);
        line-height: 1.2;
      }
      .sembunyi { display: none !important; }

      /* ── Kartu ── */
      .kartu {
        background: var(--putih);
        border-radius: var(--radius);
        box-shadow: var(--bayangan);
        border: 0;
      }
      .kartu-isi { padding: 1.25rem 1.5rem; }
      .kartu-kepala {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.15rem 1.5rem;
        border-bottom: 1px solid var(--abu-300);
      }
      .kartu-kepala h3 { margin: 0; }

      /* ── Tombol ── */
      .tombol {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: .625rem 1.25rem;
        border: 1px solid transparent;
        border-radius: .375rem;
        background: var(--primary);
        color: #fff;
        font: inherit;
        font-size: .8125rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(50, 50, 93, .11), 0 1px 3px rgba(0, 0, 0, .08);
        transition: transform .15s, box-shadow .15s, background .15s;
      }
      .tombol:hover {
        background: var(--primary-dark);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 7px 14px rgba(50, 50, 93, .1), 0 3px 6px rgba(0, 0, 0, .08);
      }
      .tombol:disabled { opacity: .65; cursor: not-allowed; transform: none; }
      .tombol.sekunder {
        background: var(--putih);
        color: var(--abu-700);
        border-color: var(--abu-300);
      }
      .tombol.sekunder:hover { background: var(--abu-100); color: var(--abu-800); }
      .tombol.bahaya { background: var(--danger); }
      .tombol.bahaya:hover { background: #ec0c38; }
      .tombol.terang {
        background: rgba(255, 255, 255, .18);
        color: #fff;
        border-color: rgba(255, 255, 255, .35);
        box-shadow: none;
      }
      .tombol.terang:hover { background: rgba(255, 255, 255, .3); }
      .tombol.kecil { padding: .375rem .75rem; font-size: .75rem; }
      .tombol.penuh { width: 100%; }

      /* ── Formulir ── */
      .kolom { margin-bottom: 1rem; }
      .kolom label {
        display: block;
        font-size: .75rem;
        font-weight: 600;
        color: var(--abu-800);
        margin-bottom: .35rem;
      }
      input, select {
        width: 100%;
        padding: .625rem .85rem;
        font: inherit;
        font-size: .875rem;
        color: var(--abu-700);
        background: var(--putih);
        border: 1px solid var(--abu-400);
        border-radius: .375rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, .04);
        transition: border-color .15s, box-shadow .15s;
      }
      input:focus, select:focus {
        outline: none;
        border-color: rgba(50, 151, 211, .55);
        box-shadow: 0 0 0 3px rgba(94, 114, 228, .18);
      }
      input::placeholder { color: var(--abu-400); }

      /* ── Lencana ── */
      .lencana {
        display: inline-block;
        padding: .28rem .6rem;
        border-radius: 10rem;
        font-size: .6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .02em;
        white-space: nowrap;
      }
      .lencana.izin { background: #b0eed3; color: #0b7a4b; }
      .lencana.blokir { background: #fdd1da; color: #b81a3c; }
      .lencana.tunggu { background: #fee6d8; color: #cc4b1c; }
      .lencana.netral { background: var(--abu-300); color: var(--abu-700); }
      .lencana.info { background: #aaedf9; color: #0a7c95; }

      /* ── Pesan ── */
      .pesan {
        padding: .75rem 1rem;
        border-radius: .375rem;
        font-size: .8125rem;
        margin-bottom: 1rem;
      }
      .pesan.galat { background: #fdd1da; color: #b81a3c; }
      .pesan.sukses { background: #b0eed3; color: #0b7a4b; }

      /* ── Tabel ── */
      table { width: 100%; border-collapse: collapse; }
      thead th {
        padding: .75rem 1.5rem;
        background: var(--abu-100);
        border-top: 1px solid var(--abu-300);
        border-bottom: 1px solid var(--abu-300);
        font-size: .65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--abu-600);
        text-align: left;
        white-space: nowrap;
      }
      tbody td {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--abu-300);
        font-size: .8125rem;
        vertical-align: middle;
      }
      tbody tr:first-child td { border-top: 0; }
      .tabel-gulir { overflow-x: auto; }

      /* ── Status kosong ── */
      .kosong {
        text-align: center;
        color: var(--abu-600);
        padding: 3rem 1.5rem;
      }
      .kosong-ikon { font-size: 2.5rem; display: block; margin-bottom: .5rem; }

      /* ── Ikon lingkaran berwarna ── */
      .ikon-bulat {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 4px 6px rgba(50, 50, 93, .11);
      }
      .ikon-bulat svg { width: 1.15rem; height: 1.15rem; }
      .bg-primary { background: var(--primary); }
      .bg-info { background: var(--info); }
      .bg-success { background: var(--success); }
      .bg-danger { background: var(--danger); }
      .bg-warning { background: var(--warning); }
      .bg-dark { background: var(--dark); }

      .teks-sukses { color: var(--success); }
      .teks-bahaya { color: var(--danger); }
      .teks-peringatan { color: var(--warning); }

      @media (max-width: 768px) {
        .wadah { padding: 0 1rem; }
        h1 { font-size: 1.4rem; }
      }
    </style>
  </body>
</html>
