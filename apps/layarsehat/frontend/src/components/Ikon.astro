<!-- width/height jadi cadangan bila tidak ada kelas ukuran; CSS tetap menang. -->
<svg
  class={kelas}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={jalur[nama] ?? ''}
/>
