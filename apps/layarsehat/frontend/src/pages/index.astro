---
import Layout from '../layouts/Layout.astro';
import Ikon from '../components/Ikon.astro';

const fitur = [
  {
    ikon: 'kunci',
    warna: 'bg-danger',
    judul: 'Kendali Aplikasi',
    teks: 'Tentukan aplikasi mana yang boleh dipakai di HP anak. Aplikasi baru bisa otomatis dikunci sampai Anda menyetujuinya.',
  },
  {
    ikon: 'waktu',
    warna: 'bg-warning',
    judul: 'Batas Waktu Layar',
    teks: 'Atur durasi pemakaian harian dan jam tidur. Setelah kuota habis, aplikasi hiburan berhenti dengan sendirinya.',
  },
  {
    ikon: 'grafik',
    warna: 'bg-info',
    judul: 'Laporan Pemakaian',
    teks: 'Lihat aplikasi apa yang paling sering dibuka anak dan berapa lama, lengkap dengan tren harian.',
  },
  {
    ikon: 'perangkat',
    warna: 'bg-success',
    judul: 'Pemasangan Terpantau',
    teks: 'Setiap kali ada aplikasi baru terpasang, Anda langsung melihatnya di dasbor beserta waktu pemasangannya.',
  },
];

const langkah = [
  { no: '1', judul: 'Buat akun orang tua', teks: 'Daftar gratis, lalu tambahkan profil anak Anda di dasbor.' },
  { no: '2', judul: 'Pasang di HP anak', teks: 'Unduh aplikasi LayarSehat, masukkan kode pemasangan 6 digit dari dasbor.' },
  { no: '3', judul: 'Atur & pantau', teks: 'Tentukan aturan aplikasi dan batas waktu. Perangkat menyesuaikan otomatis.' },
];
---

<Layout title="Pantau HP Anak dengan Tenang">
  <nav class="navbar">
    <div class="wadah navbar-isi">
      <a class="merek" href="/"><span class="merek-ikon">📱</span><span>LayarSehat</span></a>
      <div class="nav-tautan">
        <a href="#fitur">Fitur</a>
        <a href="#cara">Cara Kerja</a>
        <a href="/unduh">Unduh</a>
        <a href="/masuk">Masuk</a>
        <a class="tombol kecil" href="/daftar">Daftar Gratis</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="wadah hero-isi">
      <span class="kicker">Kontrol orang tua buatan Indonesia</span>
      <h1>Ketahui apa yang anak Anda lakukan di layar HP-nya</h1>
      <p class="hero-teks">
        LayarSehat membantu Anda memantau aplikasi yang terpasang di HP anak, mengunci
        yang tidak pantas, serta membatasi waktu bermain — semuanya dari satu dasbor.
      </p>
      <div class="hero-tombol">
        <a class="tombol" href="/daftar">Mulai Sekarang, Gratis</a>
        <a class="tombol terang" href="/unduh">Unduh Aplikasi Android</a>
      </div>
      <p class="hero-catatan">Tanpa biaya langganan · Data tersimpan di server Indonesia</p>
    </div>
  </header>

  <section id="fitur" class="bagian">
    <div class="wadah">
      <div class="kisi">
        {fitur.map((f) => (
          <article class="kartu fitur">
            <div class="kartu-isi">
              <div class={`ikon-bulat ${f.warna}`}><Ikon nama={f.ikon} /></div>
              <h3>{f.judul}</h3>
              <p class="kecil lembut" style="margin:0">{f.teks}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="cara" class="bagian">
    <div class="wadah">
      <div class="bagian-kepala">
        <h2>Tiga langkah, selesai dalam 5 menit</h2>
        <p class="lembut">Tidak perlu pengaturan rumit atau akses khusus.</p>
      </div>
      <div class="kisi tiga">
        {langkah.map((l) => (
          <article class="kartu">
            <div class="kartu-isi">
              <span class="nomor">{l.no}</span>
              <h3>{l.judul}</h3>
              <p class="kecil lembut" style="margin:0">{l.teks}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bagian">
    <div class="wadah">
      <div class="kartu jujur">
        <div class="kartu-isi">
          <h3>🤝 Pantau dengan jujur, bukan diam-diam</h3>
          <p class="lembut" style="margin:0">
            LayarSehat dirancang untuk dipakai secara terbuka bersama anak. Aplikasi tetap
            terlihat di HP anak dan tidak menyembunyikan dirinya. Bicarakan aturannya bersama —
            pengawasan yang disepakati jauh lebih efektif daripada yang disembunyikan.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bagian">
    <div class="wadah ajakan">
      <h2>Siap mencoba?</h2>
      <p class="lembut">Buat akun orang tua dan hubungkan perangkat pertama Anda hari ini.</p>
      <a class="tombol" href="/daftar">Buat Akun Orang Tua</a>
    </div>
  </section>

  <footer class="kaki">
    <div class="wadah">
      <p style="margin:0">© {new Date().getFullYear()} LayarSehat · layarsehat.nasir.id</p>
    </div>
  </footer>

  <style>
    .navbar {
      position: sticky; top: 0; z-index: 30;
      background: var(--putih);
      box-shadow: 0 1px 3px rgba(50, 50, 93, .08);
    }
    .navbar-isi {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; height: 68px;
    }
    .merek {
      display: inline-flex; align-items: center; gap: .5rem;
      color: var(--abu-800); font-weight: 700; font-size: 1.05rem;
    }
    .merek-ikon { font-size: 1.35rem; }
    .nav-tautan { display: flex; align-items: center; gap: 1.25rem; }
    .nav-tautan a { color: var(--abu-700); font-size: .8125rem; font-weight: 600; }
    .nav-tautan a:hover { color: var(--primary); }
    .nav-tautan a.tombol { color: #fff; }

    .hero {
      background: var(--gradien);
      padding: 4.5rem 0 7rem;
      text-align: center;
      clip-path: ellipse(140% 100% at 50% 0);
    }
    .hero-isi { max-width: 720px; }
    .kicker {
      display: inline-block;
      background: rgba(255, 255, 255, .2);
      border: 1px solid rgba(255, 255, 255, .35);
      color: #fff;
      padding: .3rem .9rem;
      border-radius: 10rem;
      font-size: .75rem;
      font-weight: 600;
      margin-bottom: 1.25rem;
    }
    .hero h1 { color: #fff; font-size: 2.4rem; margin-bottom: 1rem; }
    .hero-teks { color: rgba(255, 255, 255, .85); font-size: 1rem; margin-bottom: 1.75rem; }
    .hero-tombol { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; }
    .hero-catatan { color: rgba(255, 255, 255, .7); font-size: .8125rem; margin: 1.25rem 0 0; }

    .bagian { padding: 2.5rem 0; }
    .bagian-kepala { text-align: center; margin-bottom: 1.75rem; }
    .bagian-kepala p { margin: 0; }

    .kisi { display: grid; grid-template-columns: repeat(auto-fit, minmax(235px, 1fr)); gap: 1.5rem; }
    .kisi.tiga { grid-template-columns: repeat(auto-fit, minmax(255px, 1fr)); }
    #fitur { margin-top: -5rem; position: relative; z-index: 2; }
    .fitur h3 { margin: .85rem 0 .4rem; }

    .nomor {
      display: grid; place-items: center;
      width: 2rem; height: 2rem; border-radius: 50%;
      background: var(--primary); color: #fff;
      font-weight: 700; font-size: .8125rem;
      margin-bottom: .75rem;
    }
    .jujur { background: var(--dark-2); }
    .jujur h3, .jujur p { color: #fff; }
    .jujur p.lembut { color: rgba(255, 255, 255, .75); }

    .ajakan { text-align: center; }
    .ajakan h2 { margin-bottom: .25rem; }
    .ajakan p { margin-bottom: 1.25rem; }

    .kaki {
      padding: 2rem 0;
      border-top: 1px solid var(--abu-300);
      color: var(--abu-600);
      font-size: .8125rem;
      text-align: center;
    }

    @media (max-width: 768px) {
      .hero { padding: 3rem 0 6rem; }
      .hero h1 { font-size: 1.7rem; }
      .nav-tautan { gap: .85rem; }
      .nav-tautan a:not(.tombol) { display: none; }
    }
  </style>
</Layout>
