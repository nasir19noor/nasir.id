---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
  title="Daftar"
  judul="Buat akun orang tua"
  keterangan="Gratis — satu akun cukup untuk semua perangkat anak Anda."
>
  <div class="kartu">
    <div class="kartu-isi" style="padding:1.75rem">
      <p class="pengantar">Isi data berikut untuk memulai</p>

      <div id="galat" class="pesan galat sembunyi"></div>

      <form id="form-daftar">
        <div class="kolom">
          <label for="nama">Nama lengkap</label>
          <input id="nama" type="text" required placeholder="Budi Santoso" />
        </div>
        <div class="kolom">
          <label for="email">Email</label>
          <input id="email" type="email" required autocomplete="email" placeholder="nama@email.com" />
        </div>
        <div class="kolom">
          <label for="telepon">Nomor WhatsApp <span class="lembut">(opsional)</span></label>
          <input id="telepon" type="tel" placeholder="08123456789" />
        </div>
        <div class="kolom">
          <label for="sandi">Kata sandi</label>
          <input id="sandi" type="password" required minlength="6" autocomplete="new-password" placeholder="Minimal 6 karakter" />
        </div>
        <button class="tombol penuh" type="submit" id="kirim">Daftar</button>
      </form>
    </div>
  </div>

  <p class="tautan-bawah">
    Sudah punya akun? <a href="/masuk">Masuk di sini</a>
  </p>

  <style>
    .pengantar {
      text-align: center;
      font-size: .8125rem;
      color: var(--abu-600);
      margin-bottom: 1.25rem;
    }
    .tautan-bawah {
      text-align: center;
      margin: 1.25rem 0 0;
      font-size: .8125rem;
      color: rgba(255, 255, 255, .75);
    }
    .tautan-bawah a { color: #fff; font-weight: 600; }
  </style>

  <script>
    import { api, simpanSesi, ambilToken } from '../lib/api.js';

    if (ambilToken()) window.location.href = '/dasbor';

    const galat = document.getElementById('galat');
    const kirim = document.getElementById('kirim');

    document.getElementById('form-daftar').addEventListener('submit', async (e) => {
      e.preventDefault();
      galat.classList.add('sembunyi');
      kirim.disabled = true;
      kirim.textContent = 'Memproses…';

      try {
        const data = await api('/parents/register', {
          method: 'POST',
          body: JSON.stringify({
            full_name: document.getElementById('nama').value.trim(),
            email: document.getElementById('email').value.trim(),
            phone_number: document.getElementById('telepon').value.trim() || null,
            password: document.getElementById('sandi').value,
          }),
        });
        simpanSesi(data.access_token, data.parent);
        window.location.href = '/dasbor';
      } catch (err) {
        galat.textContent = err.message;
        galat.classList.remove('sembunyi');
        kirim.disabled = false;
        kirim.textContent = 'Daftar';
      }
    });
  </script>
</AuthLayout>
