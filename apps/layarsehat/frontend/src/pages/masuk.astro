---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout
  title="Masuk"
  judul="Selamat datang kembali"
  keterangan="Masuk untuk mengelola perangkat dan aturan aplikasi anak Anda."
>
  <div class="kartu">
    <div class="kartu-isi" style="padding:1.75rem">
      <p class="pengantar">Masuk dengan akun orang tua</p>

      <div id="galat" class="pesan galat sembunyi"></div>

      <form id="form-masuk">
        <div class="kolom">
          <label for="email">Email</label>
          <input id="email" type="email" required autocomplete="email" placeholder="nama@email.com" />
        </div>
        <div class="kolom">
          <label for="sandi">Kata sandi</label>
          <input id="sandi" type="password" required autocomplete="current-password" placeholder="••••••••" />
        </div>
        <button class="tombol penuh" type="submit" id="kirim">Masuk</button>
      </form>
    </div>
  </div>

  <p class="tautan-bawah">
    Belum punya akun? <a href="/daftar">Daftar gratis</a>
  </p>

  <style>
    .pengantar {
      text-align: center;
      font-size: .8125rem;
      color: var(--abu-600);
      margin-bottom: 1.25rem;
    }
    .tautan-bawah {
      text-align: center;
      margin: 1.25rem 0 0;
      font-size: .8125rem;
      color: rgba(255, 255, 255, .75);
    }
    .tautan-bawah a { color: #fff; font-weight: 600; }
  </style>

  <script>
    import { api, simpanSesi, ambilToken } from '../lib/api.js';

    if (ambilToken()) window.location.href = '/dasbor';

    const galat = document.getElementById('galat');
    const kirim = document.getElementById('kirim');

    document.getElementById('form-masuk').addEventListener('submit', async (e) => {
      e.preventDefault();
      galat.classList.add('sembunyi');
      kirim.disabled = true;
      kirim.textContent = 'Memproses…';

      try {
        const data = await api('/parents/login', {
          method: 'POST',
          body: JSON.stringify({
            email: document.getElementById('email').value.trim(),
            password: document.getElementById('sandi').value,
          }),
        });
        simpanSesi(data.access_token, data.parent);
        window.location.href = '/dasbor';
      } catch (err) {
        galat.textContent = err.message;
        galat.classList.remove('sembunyi');
        kirim.disabled = false;
        kirim.textContent = 'Masuk';
      }
    });
  </script>
</AuthLayout>
