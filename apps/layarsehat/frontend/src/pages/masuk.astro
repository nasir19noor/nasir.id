---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Masuk">
  <nav class="navbar">
    <div class="wadah navbar-isi">
      <a class="merek" href="/"><span>📱</span><span>LayarSehat</span></a>
      <div class="nav-tautan"><a href="/daftar">Belum punya akun?</a></div>
    </div>
  </nav>

  <main class="sempit" style="padding-top:3rem">
    <div class="kartu">
      <h1 style="font-size:1.4rem">Masuk ke akun orang tua</h1>
      <p class="lembut">Kelola perangkat dan aturan aplikasi anak Anda.</p>

      <div id="galat" class="pesan galat sembunyi"></div>

      <form id="form-masuk">
        <div class="kolom">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="nama@email.com" />
        </div>
        <div class="kolom">
          <label for="sandi">Kata sandi</label>
          <input id="sandi" name="sandi" type="password" required autocomplete="current-password" placeholder="••••••••" />
        </div>
        <button class="tombol penuh" type="submit" id="kirim">Masuk</button>
      </form>

      <p class="lembut" style="text-align:center; margin:1rem 0 0">
        Belum punya akun? <a href="/daftar">Daftar gratis</a>
      </p>
    </div>
  </main>

  <script>
    import { api, simpanSesi, ambilToken } from '../lib/api.js';

    if (ambilToken()) window.location.href = '/dasbor';

    const form = document.getElementById('form-masuk');
    const galat = document.getElementById('galat');
    const kirim = document.getElementById('kirim');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      galat.classList.add('sembunyi');
      kirim.disabled = true;
      kirim.textContent = 'Memproses…';

      try {
        const data = await api('/parents/login', {
          method: 'POST',
          body: JSON.stringify({
            email: document.getElementById('email').value.trim(),
            password: document.getElementById('sandi').value,
          }),
        });
        simpanSesi(data.access_token, data.parent);
        window.location.href = '/dasbor';
      } catch (err) {
        galat.textContent = err.message;
        galat.classList.remove('sembunyi');
        kirim.disabled = false;
        kirim.textContent = 'Masuk';
      }
    });
  </script>
</Layout>
