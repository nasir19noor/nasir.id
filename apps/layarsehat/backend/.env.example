# LayarSehat backend environment variables
# Production copy lives at s3://layarsehat.nasir.id/backend/.env

# PostgreSQL connection string (sslmode=require is enforced in code)
DATABASE_URL=postgresql://user:password@localhost:5432/layarsehat

# JWT signing key (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change_me

ENVIRONMENT=development
