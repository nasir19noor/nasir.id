PORT=9003
CORS_ORIGINS=https://agent.nasir.id,http://localhost:5003

AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_ACCESS_KEY_ID=your_iam_user_access_key_id
AWS_SECRET_ACCESS_KEY=your_iam_user_secret_access_key

DATABASE_URL=postgresql://user:password@localhost:5432/agent

MAX_TOKENS=2048
MAX_AGENT_STEPS=10
SHELL_ALLOWLIST=ls,cat,df,free,uptime,systemctl status,docker ps,docker logs,git status,git log,tail

# GitHub PAT — Settings > Developer settings. Used for both inspection
# (issues, PRs, Actions, commits, repo listing) and repo creation. For
# inspection only, a fine-grained token with read-only Issues/Pull
# requests/Actions/Contents is enough. To also let the agent create repos,
# use a classic PAT with the `repo` (private) or `public_repo` (public-only)
# scope, or a fine-grained PAT with "Administration: read and write" under
# Account permissions. Leave blank to disable the GitHub tools (they'll
# return a clear "not configured" message).
GITHUB_TOKEN=

# Google Drive, read-only, nasir19noor@gmail.com only. Create an OAuth client
# at https://console.cloud.google.com (APIs & Services > Credentials, type
# "Desktop app", with the Drive API enabled), put its id/secret below, then
# run `python scripts/google_drive_oauth_setup.py` to mint the refresh token.
# Leave blank to disable the Drive tools (they'll return a clear "not
# configured" message).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# HTTP Basic auth — required on every endpoint except /health. The agent can
# run shell commands and query production data, so this must always be set.
# The frontend collects these once and stores them in sessionStorage.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
