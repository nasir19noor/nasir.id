# PostgreSQL connection string. The database is created automatically on
# first start if it doesn't exist (same credentials, 'postgres' maintenance DB).
DATABASE_URL=postgresql://user:password@host:5432/ucl

# Public ESPN scoreboard endpoint for the UEFA Champions League. No API key.
ESPN_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard

# Season window fetched from ESPN (league phase MD1 → final).
ESPN_START_DATE=2026-09-14
ESPN_END_DATE=2027-06-06

# Hourly refresh while the season runs; set false after the final.
SEASON_ACTIVE=true
REFRESH_INTERVAL_MIN=60

# CORS — comma-separated list. The frontend domain.
CORS_ORIGINS=https://ucl.nasir.id,http://localhost:5004

# Run env
ENVIRONMENT=production

# Admin credentials — protect the /admin/* endpoints with HTTP Basic auth.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
